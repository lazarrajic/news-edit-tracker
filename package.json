{
  "name": "nz-news-edit-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Polling nz news outlets, capturing each article over a period of time to see if any substantial changes were made and if they were announced.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "poll": "node --env-file-if-exists=.env src/poll.js",
    "diff": "node --env-file-if-exists=.env src/run-diffs.js",
    "flag-live": "node --env-file-if-exists=.env src/flag-live-blogs.js",
    "review": "node --env-file-if-exists=.env src/review.js",
    "backfill-notices": "node --env-file-if-exists=.env src/backfill-notices.js",
    "evaluate": "node --env-file-if-exists=.env src/evaluate.js"
  },
  
  "dependencies": {
    "@supabase/supabase-js": "^2.111.0",
    "cheerio": "^1.2.0",
    "diff": "^9.0.0",
    "rss-parser": "^3.13.0"
  }
}
